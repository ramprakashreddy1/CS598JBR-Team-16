import java.util.*;

public class Solution {
    public static List<Integer> orderByPoints(List<Integer> nums) {
        nums.sort(Comparator.comparing(Solution::digitsSum));
        return nums;
    }

    private static int digitsSum(int n) {
        int neg = 1;
        if (n < 0) {
            n *= -1;
            neg = -1;
        }
        int sum = 0;
        while (n > 0) {
            sum += n % 10;
            n /= 10;
        }
        return sum * neg;
    }

    public static void main(String[] args) {
        System.out.println(orderByPoints(Arrays.asList(1, 11, -1, -11, -12))); // prints [-1, -11, 1, -12, 11]
        System.out.println(orderByPoints(Arrays.asList())); // prints []
    }
}
```

