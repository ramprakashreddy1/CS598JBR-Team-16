import java.util.Arrays;
import java.util.PriorityQueue;

public class Solution {
    public int[] maximum(int[] arr, int k) {
        if (k == 0) {
            return new int[0];
        }
        Arrays.sort(arr);
        int[] ans = new int[k];
        for (int i = 0; i < k; i++) {
            ans[i] = arr[arr.length - 1 - i];
        }
        return ans;
    }
}
