import java.util.ArrayList;
import java.util.Collections;

public class Solution {
    public static Integer[] largest_smallest_integers(ArrayList<Integer> lst) {
        ArrayList<Integer> smallest = new ArrayList<Integer>();
        ArrayList<Integer> largest = new ArrayList<Integer>();

        for (Integer num : lst) {
            if (num < 0) {
                smallest.add(num);
            } else if (num > 0) {
                largest.add(num);
            }
        }

        Integer[] result = new Integer[2];
        if (smallest.isEmpty()) {
            result[0] = null;
        } else {
            result[0] = Collections.max(smallest);
        }

        if (largest.isEmpty()) {
            result[1] = null;
        } else {
            result[1] = Collections.min(largest);
        }

        return result;
    }
}
```

