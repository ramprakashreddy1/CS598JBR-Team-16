import java.util.*;

public class Solution {
    public static double[] findClosestElements(float[] numbers) {
        if (numbers.length < 2) {
            throw new IllegalArgumentException("List must have at least two elements");
        }

        double[] closestPair = new double[2];
        double minDistance = Double.MAX_VALUE;

        for (int i = 0; i < numbers.length; i++) {
            for (int j = 0; j < numbers.length; j++) {
                if (i != j) {
                    double distance = Math.abs(numbers[i] - numbers[j]);
                    if (distance < minDistance) {
                        minDistance = distance;
                        closestPair[0] = Math.min(numbers[i], numbers[j]);
                        closestPair[1] = Math.max(numbers[i], numbers[j]);
                    }
                }
            }
        }

        return closestPair;
    }

    public static void main(String[] args) {
        float[] numbers = {1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 2.2f};
        double[] closestElements = findClosestElements(numbers);
        System.out.println(closestElements[0] + ", " + closestElements[1]);
    }
}
```

