import java.util.List;
import java.util.AbstractMap;

public class Solution {
    public static AbstractMap.SimpleEntry<Integer, Integer> sumProduct(List<Integer> numbers) {
        int sum = 0;
        int product = 1;

        for (int n : numbers) {
            sum += n;
            product *= n;
        }
        return new AbstractMap.SimpleEntry<>(sum, product);
    }
}
