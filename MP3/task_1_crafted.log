import java.util.*;
import java.lang.*;

class Solution {
    public List<Integer> orderByPoints(List<Integer> nums) {
        if (nums == null || nums.size() == 0) {
            return new ArrayList<>();
        }

        nums.sort(Comparator.comparing(this::digitsSum).thenComparing(nums::indexOf));
        return nums;
    }

    private int digitsSum(int n) {
        int neg = 1;
        if (n < 0) {
            n *= -1;
            neg = -1;
        }

        int sum = 0;
        while (n > 0) {
            sum += n % 10;
            n /= 10;
        }

        return sum * neg;
    }
}
