import java.util.stream.*;

class Solution {
    public List<Optional<Integer>> largestSmallestIntegers(List<Integer> lst){
        List<Integer> negatives = lst.stream().filter(i -> i < 0).collect(Collectors.toList());
        List<Integer> positives = lst.stream().filter(i -> i > 0).collect(Collectors.toList());

        Optional<Integer> smallest = negatives.isEmpty() ? Optional.empty() : Optional.of(Collections.min(negatives));
        Optional<Integer> largest = positives.isEmpty() ? Optional.empty() : Optional.of(Collections.max(positives));

        return Arrays.asList(smallest, largest);
    }
}
