import java.util.*;

class Solution {
    public List<Double> findClosestElements(List<Double> numbers) {
        if (numbers.size() < 2) {
            throw new IllegalArgumentException("List must have at least two elements");
        }

        double minDifference = Double.MAX_VALUE;
        List<Double> closestPair = new ArrayList<>();

        for (int i = 0; i < numbers.size(); i++) {
            for (int j = i + 1; j < numbers.size(); j++) {
                double difference = Math.abs(numbers.get(i) - numbers.get(j));
                if (difference < minDifference) {
                    minDifference = difference;
                    closestPair.clear();
                    closestPair.add(Math.min(numbers.get(i), numbers.get(j)));
                    closestPair.add(Math.max(numbers.get(i), numbers.get(j)));
                }
            }
        }

        return closestPair;
    }
}
